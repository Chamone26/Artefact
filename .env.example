# Copie para .env e preencha. O .env fica fora do repositório.

# Obrigatória. Crie a chave em https://platform.claude.com
ANTHROPIC_API_KEY=

# Opcionais: os valores abaixo são os padrões.
# AGENT_MODEL=claude-haiku-5-5
# AGENT_API_URL=http://127.0.0.1:8000
# Data que o agente considera "hoje". Os pedidos da base vão até 2026-03-22.
# AGENT_TODAY=2026-03-25
# Limite de passos do grafo por mensagem. Cada rodada de tools gasta dois passos; 15 permite 6 rodadas.
# AGENT_RECURSION_LIMIT=15
