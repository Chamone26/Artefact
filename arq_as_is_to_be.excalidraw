      "boundElements": [],
      "updated": 1793574243951,
      "created": 1793574243951,
      "link": null,
      "locked": false,
      "text": "Fora do desenho original, mas real hoje: a API de dados fica entre as tools e o banco.\nO Backend e o AI Gateway do arq_revisada não foram implementados.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fora do desenho original, mas real hoje: a API de dados fica entre as tools e o banco.\nO Backend e o AI Gateway do arq_revisada não foram implementados.",
